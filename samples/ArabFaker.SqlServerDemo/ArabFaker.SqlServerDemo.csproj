<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ArabFaker.NET\ArabFaker.NET.csproj" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.*" />
    <!-- SqlClient 7.x pulls in System.Security.Cryptography.Pkcs 9.0.18, which has known high-severity
         advisories (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). Pin the patched version until SqlClient does. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
